# ---- Bridge config ----
PORT=8080

# Data source: your Apify API token (Apify Console -> Settings -> Integrations -> API token)
# Leave blank to run on bundled SAMPLE data (great for a first demo).
APIFY_TOKEN=
# Actor id in owner~name form:
ACTOR=techforce.global~flipkart-scraper

# Force sample data even if a token is set (instant demo, no Apify usage):
# MOCK_DATA=1

# ---- x402 monetization (the part agentic.market needs) ----
# Your wallet that receives USDC:
PAY_TO=0xYOUR_WALLET_ADDRESS
PRICE=$0.05
# testnet: base-sepolia   |   production: base
NETWORK=base-sepolia
# testnet facilitator (free). For Base mainnet use the Coinbase CDP facilitator (see README).
FACILITATOR_URL=https://x402.org/facilitator

# ---- paid-client.mjs only (to test a real paid call) ----
# A base-sepolia private key funded with test USDC + test ETH:
PRIVATE_KEY=
BRIDGE_URL=http://localhost:8080
